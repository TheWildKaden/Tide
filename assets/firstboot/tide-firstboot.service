[Unit]
Description=Tide OS first-boot diagnostic
Documentation=https://github.com/Tide-OS/Tide
ConditionPathExists=!/var/lib/tide/firstboot-done
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/lib/tide/tide-firstboot.sh
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

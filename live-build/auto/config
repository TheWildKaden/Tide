#!/bin/sh
set -e

export LB_MODE="debian"
export LB_DISTRIBUTION="bookworm"
export LB_ARCHITECTURE="amd64"
export LB_MIRROR_BOOTSTRAP="http://deb.debian.org/debian"
export LB_MIRROR_CHROOT="http://deb.debian.org/debian"
export LB_ARCHIVE_AREAS="main contrib non-free"
export LB_PACKAGES="openssh-server sudo locales net-tools iproute2 ca-certificates"
export LB_COMPRESSION="xz"
export LB_BOOT_APPEND="boot=live quiet splash"

exec lb config noauto "$@"
